{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "useDefineForClassFields": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "allowSyntheticDefaultImports": true,
    "esModuleInterop": true, "isolatedModules": true, "skipLibCheck": true,
    "noEmit": true, "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
